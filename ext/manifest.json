{
  "manifest_version": 3,
  "name": "MoReader - EPUB Reader",
  "short_name": "MoReader",
  "version": "2.9.1",
  "description": "Immersive EPUB reader with neural TTS read aloud, millisecond sentence sync, deep chapter summaries & comprehension quizzes.",
  "permissions": [],
  "action": {
    "default_title": "Open MoReader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
