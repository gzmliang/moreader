{
  "manifest_version": 3,
  "name": "MoReader - EPUB & PDF Reader with Read Aloud",
  "short_name": "MoReader",
  "version": "2.9.9",
  "description": "EPUB & PDF reader with read-aloud text-to-speech, sentence highlight sync, bilingual view and AI chapter summaries.",
  "permissions": [],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "Open MoReader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}