{
  "manifest_version": 3,
  "name": "MoReader: AI TTS & Smart EPUB Reader",
  "short_name": "MoReader",
  "version": "2.9.0",
  "description": "Immersive EPUB reader with neural TTS read aloud, millisecond sentence sync, Blinkist-style AI summaries & comprehension quizzes.",
  "permissions": [],
  "action": {
    "default_title": "Open MoReader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "assets/*",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}