{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_appName__",
  "short_name": "__MSG_shortName__",
  "version": "2.9.0",
  "description": "__MSG_appDesc__",
  "permissions": [],
  "action": {
    "default_title": "打开墨阅",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "assets/*",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}